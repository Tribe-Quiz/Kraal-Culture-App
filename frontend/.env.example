# Supabase project: Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Base URL of the backend. Leave empty in development (Vite proxies /api to localhost:5000).
# In production set it to the deployed backend, e.g. https://api.your-domain.com
VITE_API_URL=
